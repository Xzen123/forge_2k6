# ============================================================
# Civic Pulse — Environment Variables
# Copy to .env and fill in your secrets.
# Never commit .env to version control.
# ============================================================

# --- LLM -------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MODEL_FALLBACK=claude-3-haiku-20240307

# --- Database --------------------------------------------------
# For local Docker: postgresql+asyncpg://civic:civic@localhost:5432/civic_pulse
DATABASE_URL=postgresql+asyncpg://civic:civic@localhost:5432/civic_pulse
POSTGRES_USER=civic
POSTGRES_PASSWORD=civic
POSTGRES_DB=civic_pulse

# --- Embeddings (local model, no key needed) -------------------
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_BATCH_SIZE=32

# --- Sarvam AI (speech + translation) --------------------------
SARVAM_API_KEY=your-sarvam-key-here
SARVAM_API_BASE=https://api.sarvam.ai
SARVAM_STT_MODEL=saarika:v2
SARVAM_TTS_MODEL=bulbul:v1
SARVAM_TRANSLATE_MODEL=mayura:v1

# --- Official data sources -------------------------------------
MYSCHEME_API_BASE=https://api.myscheme.gov.in
PIB_RSS_URL=https://pib.gov.in/RssMain.aspx?ModId=6&Lang=1&Regid=3
INDIA_CODE_BASE=https://www.indiacode.nic.in
DATA_GOV_IN_BASE=https://api.data.gov.in
DATA_GOV_IN_API_KEY=your-data-gov-in-key-here

# --- Ingestion scheduler ---------------------------------------
INGEST_INTERVAL_MINUTES=60
INGEST_MAX_RETRIES=3
INGEST_BACKOFF_BASE=2.0
INGEST_CIRCUIT_BREAKER_THRESHOLD=5
INGEST_CIRCUIT_BREAKER_COOLDOWN=300

# --- Retrieval -------------------------------------------------
RETRIEVAL_K=20
RETRIEVAL_RERANK_TOP=5
RETRIEVAL_SCORE_THRESHOLD=0.35
RETRIEVAL_LATENCY_TARGET_MS=1000

# --- Agent -----------------------------------------------------
AGENT_MAX_RETRIES=2
AGENT_COMPOSE_MAX_CLAIM_FAIL_RATIO=0.5
AGENT_TOKEN_BUDGET_PER_SESSION=20000

# --- Languages -------------------------------------------------
SUPPORTED_LANGUAGES=en,hi,bn

# --- Langfuse (optional, for observability) --------------------
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# --- API -------------------------------------------------------
API_FRONTEND_ORIGIN=http://localhost:3000
API_ADMIN_TOKEN=change-me-in-production
API_RATE_LIMIT_PER_MINUTE=30

# --- TTS cache -------------------------------------------------
TTS_CACHE_DIR=/tmp/civic_pulse_tts_cache

# --- General ---------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
